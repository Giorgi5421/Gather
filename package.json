    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.5",
    "ioredis": "^5.7.0",
    "lucide-react": "^0.542.0",
    "next": "^15.5.2",
    "next-auth": "5.0.0-beta.29",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
